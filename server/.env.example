PORT=8080
DATABASE_URL=linky:linky@tcp(localhost:3306)/linky?parseTime=true&multiStatements=true
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h
OAUTH_REDIRECT_BASE=http://localhost:8080/authback
COOKIE_SECURE=false

# Externally reachable origin (no trailing slash). Used as the OAuth issuer /
# resource identifier for the MCP endpoint, so it must match the URL MCP clients
# connect to (e.g. https://linky.example.com).
PUBLIC_BASE_URL=http://localhost:8080

# Content backend (for archive endpoint)
CONTENT_API_URL=https://content.oglimmer.com
CONTENT_API_USER=
CONTENT_API_PASS=

# OIDC SSO
OIDC_ISSUER_URL=https://id.oglimmer.de/realms/oglimmer
OIDC_CLIENT_ID=linky
OIDC_CLIENT_SECRET=
